  "list_identity": [
    {
      "host": "amazon.com",
      "pattern": "/dp/([A-Z0-9]{10})(?:/|$)",
      "prefix": "/dp/",
      "group": 1
    },
    {
      "host": "reddit.com",
      "pattern": "(/r/[^/]+/comments/[^/]+)",
      "prefix": "",
      "group": 1
    }
  ],
  "list_name_prefix_pattern": "^(?:top rated\\s*|free\\s+)",
  "dynamic_cases": {
    "dynamic-quotes-api": {
      "fields": [
        "quote",
        "author",
        "tags"
      ]
    },
    "dynamic-delayed": {
      "fields": [
        "quote",
        "author",
        "tags"
      ]
    },
    "dynamic-products-api": {
      "fields": [
        "name",
        "price"
      ]
    },
    "dynamic-catalog": {
      "fields": [
        "price",
        "title",
        "description",
        "reviews"
      ]
    },
    "dynamic-reviews-graphql": {
      "fields": [
        "date",
        "text"
      ]
    },
    "dynamic-product-reviews": {
      "fields": [
        "date",
        "text"
      ]
    },
    "dynamic-angular-phones": {
      "fields": [
        "name",
        "description"
      ]
    },
    "dynamic-swagger": {
      "fields": [
        "method",
        "path",
        "summary"
      ]
    },
    "dynamic-iframe": {
      "fields": [
        "family"
      ]
    },
    "dynamic-react-cart": {
      "fields": [
        "name",
        "price",
        "financing",
        "shipping"
      ],
      "optional_fields": [
        {
          "field": "financing",
          "index": 2,
          "prefix": "or "
        },
        {
          "field": "shipping",
          "index": -1,
          "equals": "Free shipping"
        }
      ]
    }
  },
  "dynamic_field_prefixes": {
    "author": "by ",
    "tags": "Tags: "
  },
  "dynamic_compact_fields": {
    "reviews": "\\d+\\s+reviews?"
  },
  "article_patterns": {
    "section_leading_count": "^[0-9]+(?:\\s*(?:条|则|件)\\s*|\\s+)",
    "section_trailing_count": "\\s*(?:\\(\\s*[0-9]+\\s*(?:条|则|件)?\\s*\\)|（\\s*[0-9]+\\s*(?:条|则|件)?\\s*）)\\s*$",
    "comment_timestamp": "(?:\\d{4}[-/]\\d{1,2}[-/]\\d{1,2}(?:[ T]\\d{1,2}:\\d{2}(?::\\d{2})?(?:Z|[+-]\\d{2}:?\\d{2})?)?|\\d{1,2}:\\d{2}(?::\\d{2})?(?:\\s*[AP]M)?|\\d+\\s+(?:seconds?|minutes?|hours?|days?|weeks?|months?|years?)\\s+ago|\\d+\\s*(?:秒|分钟|小时|天|周|个月|年)前|刚刚)",
    "pingback_record": "\\s*Pingback:\\s+(.+?)\\s*",
    "post_non_author_label": "(?:today|yesterday|date|time|permalink|view post|post|今天|昨天|详情|查看帖子|\\d{4}[-/]\\d{1,2}[-/]\\d{1,2})",
    "post_timestamp": "(?:\\d{4}[-/]\\d{1,2}[-/]\\d{1,2}(?:[ T]\\d{1,2}:\\d{2}(?::\\d{2})?(?:Z|[+-]\\d{2}:?\\d{2})?)?|\\d{1,2}:\\d{2}(?::\\d{2})?(?:\\s*[AP]M)?|\\d+\\s+(?:seconds?|minutes?|hours?|days?|weeks?|months?|years?)\\s+ago|\\d+\\s*(?:秒|分钟|小时|天|周|个月|年)前|刚刚)"
  },
